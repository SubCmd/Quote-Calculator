// 규칙: .claude/rules/database.md
// 금액은 모두 Int(원 단위, 부가세 포함). 요율은 Decimal(7,4).
// 가격 규칙은 UPDATE 하지 않고 effectiveFrom 을 가진 새 행을 INSERT 한다. (ADR-0002)
// 수량 개념이 없다. 금액은 선택한 옵션 금액의 합이다. (ADR-0008)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DiscountType {
  FIXED
  RATE
}

enum QuoteStatus {
  DRAFT
  REQUESTED
  CONFIRMED
  EXPIRED
  CANCELED
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  CONSULTATION
}

model Product {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  optionGroups OptionGroup[]
  discounts    DiscountRule[]
  bundles      OptionBundle[]
  quoteItems   QuoteItem[]

  @@map("product")
}

model OptionGroup {
  id           String   @id @default(cuid())
  productId    String   @map("product_id")
  code         String
  name         String
  /// true 면 그룹에서 최소 1개를 골라야 한다
  required     Boolean  @default(false)
  /// true 면 그룹에서 1개만 고를 수 있다 (라디오). false 면 여러 개 (체크박스)
  singleSelect Boolean  @default(true) @map("single_select")
  /// 이 그룹을 고르기 전에 선택이 있어야 하는 그룹. null 이면 제약 없음 (ADR-0010)
  dependsOnGroupId String? @map("depends_on_group_id")
  /// 이 단계를 고르는 화면에 항상 보이는 한 줄 안내. 버전을 남기지 않고 덮어쓴다 (ADR-0025)
  summary      String?
  /// 펼쳐서 읽는 긴 안내. 평문으로만 다룬다
  detail       String?
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  product Product         @relation(fields: [productId], references: [id])
  options ProductOption[]

  optionDescriptions OptionDescription[]

  dependsOnGroup OptionGroup?  @relation("GroupPrerequisite", fields: [dependsOnGroupId], references: [id])
  dependents     OptionGroup[] @relation("GroupPrerequisite")

  @@unique([productId, code])
  @@map("option_group")
}

model ProductOption {
  id      String @id @default(cuid())
  groupId String @map("group_id")
  /// 버전이 바뀌어도 유지되는 식별자. 할인 조건은 이 값으로 연결한다 (ADR-0009)
  code    String
  name    String
  /// 선택 시 더해지는 금액(원, 부가세 포함). 금액에 영향이 없으면 0
  amount    Int      @default(0)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  /// 적용 시작 일시. 금액 수정은 새 행 INSERT 로 한다
  effectiveFrom DateTime @map("effective_from")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  group OptionGroup @relation(fields: [groupId], references: [id])

  @@unique([groupId, code, effectiveFrom])
  @@index([groupId, effectiveFrom])
  @@map("product_option")
}

/// 옵션 설명. 금액 테이블(`ProductOption`)과 분리한다 (ADR-0025)
///
/// 여기에 두는 이유는 `ProductOption` 이 금액 버전 테이블이라서다. 설명을 그쪽에 넣으면
/// 오타 하나를 고칠 때마다 가격 버전 행이 쌓이고, 금액 이력을 읽을 수 없게 된다.
/// 버전 테이블이 아니므로 수정은 `upsert` 다. 변경 기록은 `AuditLog` 가 담당한다.
model OptionDescription {
  id      String @id @default(cuid())
  groupId String @map("group_id")
  /// 옵션 행 id 가 아니라 코드로 가리킨다. 행 id 는 금액 버전마다 바뀐다 (ADR-0009 와 같은 이유)
  optionCode String @map("option_code")
  /// 옵션 이름 아래 항상 보이는 한 줄
  summary String?
  /// 펼쳐서 읽는 긴 안내. 평문으로만 다룬다
  detail  String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  group OptionGroup @relation(fields: [groupId], references: [id])

  @@unique([groupId, optionCode])
  @@map("option_description")
}

/// 묶음 옵션과 그 구성 옵션의 관계. 금액 계산에 들어가지 않는다. (ADR-0037)
///
/// 구성 옵션을 전부 고른 고객에게 더 싼 묶음이 있다고 안내하기 위한 데이터다.
/// 금액 컬럼이 없다. 묶음 금액은 그 옵션 자신의 정액이다. (ADR-0026)
/// 가격 규칙 테이블이 아니므로 `effectiveFrom` 이 없고 수정은 UPDATE·DELETE 다. (ADR-0025 와 같은 선)
/// 안내는 과거 견적의 근거가 아니다. 견적에 남는 것은 고객이 실제로 고른 옵션뿐이다.
model OptionBundle {
  id        String @id @default(cuid())
  productId String @map("product_id")
  /// 구성 옵션 전부를 대체하는 묶음 옵션. 옵션 행 id 가 아니라 코드로 가리킨다 (ADR-0009 와 같은 이유)
  groupCode  String @map("group_code")
  optionCode String @map("option_code")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  product    Product                 @relation(fields: [productId], references: [id])
  components OptionBundleComponent[]

  @@unique([productId, groupCode, optionCode])
  @@map("option_bundle")
}

/// 묶음의 구성 옵션. 여기 적힌 옵션을 **전부** 고른 선택에만 안내한다.
/// 구성이 한 행도 없는 묶음은 안내 대상이 아니다. 조건이 비면 항상 후보가 되는
/// `DiscountCondition` 과 반대다. 대체할 것이 없는 묶음은 안내할 내용이 없다.
model OptionBundleComponent {
  id         String @id @default(cuid())
  bundleId   String @map("bundle_id")
  groupCode  String @map("group_code")
  optionCode String @map("option_code")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bundle OptionBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@unique([bundleId, groupCode, optionCode])
  @@map("option_bundle_component")
}

model DiscountRule {
  id        String       @id @default(cuid())
  productId String       @map("product_id")
  code      String
  name      String
  type      DiscountType
  /// FIXED 일 때 할인 금액(원). RATE 일 때 0
  amount    Int          @default(0)
  /// RATE 일 때 할인율. 15% = 0.1500. FIXED 일 때 0
  rate      Decimal      @default(0) @db.Decimal(7, 4)
  /// 할인액 동률 시 낮은 값이 우선 (ADR-0006)
  priority  Int          @default(100)
  isActive  Boolean      @default(true) @map("is_active")
  effectiveFrom DateTime @map("effective_from")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  createdBy String?      @map("created_by")

  product    Product             @relation(fields: [productId], references: [id])
  conditions DiscountCondition[]

  @@unique([productId, code, effectiveFrom])
  @@index([productId, effectiveFrom])
  @@map("discount_rule")
}

/// 할인 적용 조건. 여기 적힌 옵션을 **전부** 선택해야 할인 후보가 된다 (ADR-0009)
/// 조건이 한 행도 없으면 항상 후보다.
/// 옵션 행 id 가 아니라 코드로 가리킨다. 금액 버전이 바뀌어도 조건이 깨지지 않는다.
model DiscountCondition {
  id             String @id @default(cuid())
  discountRuleId String @map("discount_rule_id")
  groupCode      String @map("group_code")
  optionCode     String @map("option_code")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  discountRule DiscountRule @relation(fields: [discountRuleId], references: [id], onDelete: Cascade)

  @@unique([discountRuleId, groupCode, optionCode])
  @@map("discount_condition")
}

enum AuditAction {
  OPTION_VERSION_ADDED
  DISCOUNT_VERSION_ADDED
  OPTION_DEACTIVATED
  /// 기존 그룹 안에 새 옵션을 만든 기록 (ADR-0023)
  OPTION_CREATED
  /// 꺼진 옵션을 되살린 기록. 함께 되살린/건너뛴 할인 코드를 afterValue 에 담는다 (ADR-0023)
  OPTION_REACTIVATED
  /// 단계·옵션 설명 문구 수정. 대상은 targetType 으로 구분한다 (ADR-0025)
  DESCRIPTION_UPDATED
  /// 화면 표시 순서 변경. 이전 순서 → 새 순서를 담는다 (ADR-0026)
  DISPLAY_ORDER_CHANGED
  /// 할인 규칙 비활성화. 조건 옵션은 건드리지 않는다 (ADR-0026)
  DISCOUNT_DEACTIVATED
  QUOTE_STATUS_CHANGED
  /// 개인정보 열람 기록. 상세 화면을 열 때마다 남는다 (.claude/rules/admin.md)
  QUOTE_VIEWED
  /// 선택만 복사하고 금액은 다시 계산한다 (ADR-0014)
  QUOTE_CLONED
  /// 고객명으로 찾은 기록. 검색어는 남기지 않고 결과 건수만 남긴다 (ADR-0015, ADR-0022)
  QUOTE_SEARCHED
  /// 보존기간이 지난 연락처를 비운 기록. 지운 값은 담지 않는다 (ADR-0022)
  PRIVACY_PURGED
  /// 결제 방식 선택. 고객·관리자 양쪽에서 남는다 (ADR-0033)
  PAYMENT_METHOD_SELECTED
  /// 견적을 목록에서 숨긴 기록. 행은 지우지 않는다 (ADR-0035)
  QUOTE_HIDDEN
  /// 숨긴 견적을 되돌린 기록 (ADR-0035)
  QUOTE_RESTORED
  /// 견적 행을 실제로 지운 기록. REQUESTED·CANCELED 만 대상이다 (ADR-0041)
  /// 행은 사라지지만 지웠다는 사실은 남는다. 연락처는 담지 않는다.
  QUOTE_DELETED
  /// 묶음 관계 등록. 묶음 옵션과 구성 옵션 코드를 afterValue 에 담는다 (ADR-0038)
  BUNDLE_ADDED
  /// 묶음 관계 삭제. 지운 구성까지 beforeValue 에 담는다. 수정이 없으므로 기록도 이 둘뿐이다 (ADR-0038)
  BUNDLE_REMOVED
}

/// 관리자 로그인 **실패** 기록. 시도 제한 판정에만 쓴다. 성공은 담지 않는다. (ADR-0020)
/// 창(10분)을 벗어난 행은 다음 로그인 시도가 함께 지운다. 보존 의무가 없는 데이터다.
model AdminLoginAttempt {
  id String @id @default(cuid())
  /// 요청자 IP. 신뢰할 수 있는 프록시 뒤가 아니면 헤더라서 위조될 수 있다.
  /// 그래서 IP별 한도만으로 끝내지 않고 전체 한도도 함께 센다. (ADR-0020)
  ip String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@index([ip, createdAt])
  @@map("admin_login_attempt")
}

/// 가격 규칙 변경 이력. 수정·삭제하지 않는다. 변경 트랜잭션 안에서 함께 기록한다.
model AuditLog {
  id     String      @id @default(cuid())
  action AuditAction
  /// 변경한 사람. 인증이 공유 비밀번호라 지금은 'admin' 고정 (ADR-0011)
  actor  String
  /// 무엇을 바꿨는지 사람이 읽을 수 있는 한 줄
  summary String
  /// 대상 행 식별자 (option code, discount code 등)
  targetType String @map("target_type")
  targetId   String @map("target_id")
  /// 이전값 → 새값. 필드별로 담는다
  beforeValue Json? @map("before_value")
  afterValue  Json? @map("after_value")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("audit_log")
}

model Quote {
  id          String      @id @default(cuid())
  /// 고객 조회용 공개 식별자
  publicId    String      @unique @map("public_id")
  status      QuoteStatus @default(DRAFT)
  customerName  String?   @map("customer_name")
  customerPhone String?   @map("customer_phone")
  customerEmail String?   @map("customer_email")
  /// 개인정보 수집·이용 동의 시각. 파기 대상이 아니다. (ADR-0018)
  privacyConsentAt DateTime? @map("privacy_consent_at")
  /// CONFIRMED 로 전이한 시각. 보존기간 5년의 기준점이다. (ADR-0022)
  /// updatedAt 은 아무 변경에나 바뀌어서 기준이 될 수 없다.
  confirmedAt DateTime? @map("confirmed_at")
  /// 개인정보를 비운 시각. 같은 행을 두 번 세지 않기 위한 표시다. (ADR-0022)
  purgedAt DateTime? @map("purged_at")
  /// 목록에서 숨긴 시각. null 이면 보이는 견적이다. (ADR-0035)
  /// 상태가 아니라 표시 여부다. 숨겨도 status 는 그대로이고, 되돌리면 같은 publicId 가 다시 열린다.
  /// 고객 조회도 함께 닫힌다. 파기 대상 조회는 이 칸을 보지 않는다.
  hiddenAt DateTime? @map("hidden_at")
  /// 선택한 결제 방식. null이면 선택되지 않음
  paymentMethod PaymentMethod? @map("payment_method")

  /// 항목 소계 합 (부가세 포함)
  subtotal       Int
  discountAmount Int      @map("discount_amount")
  /// 최종 금액 (부가세 포함)
  totalAmount    Int      @map("total_amount")
  appliedDiscountId String? @map("applied_discount_id")

  /// 계산 입력값과 사용한 가격 규칙 버전 스냅샷 (ADR-0002)
  snapshot     Json
  calculatedAt DateTime @map("calculated_at")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdBy    String?  @map("created_by")

  items QuoteItem[]

  @@index([status, createdAt])
  /// 파기 대상(확정 후 5년) 조회용. (ADR-0022)
  @@index([status, confirmedAt])
  /// 목록 조회용. 모든 목록 질의가 hiddenAt 을 조건으로 쓴다. (ADR-0035)
  @@index([hiddenAt, createdAt])
  @@map("quote")
}

model QuoteItem {
  id        String @id @default(cuid())
  quoteId   String @map("quote_id")
  productId String @map("product_id")
  /// 선택 옵션 금액의 합 (버림 전)
  optionAmount Int @map("option_amount")
  /// 10원 단위 버림 적용 후
  subtotal  Int
  /// 선택 옵션과 옵션별 금액
  appliedOptions Json @map("applied_options")

  quote   Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([quoteId])
  @@map("quote_item")
}
