DATABASE_URL="postgresql://quote:quote@localhost:5433/quote_calculator?schema=public"

# 관리자 인증 (ADR-0011). 둘 중 하나라도 없으면 /admin 은 404 로 닫힌다.
# 운영에서는 반드시 교체한다. 지금은 공유 비밀번호 하나라 "누가" 바꿨는지 구분되지 않는다.
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

# 견적서 발행처 (ADR-0016). 설정한 항목만 견적서에 찍힌다.
# 비어 있어도 출력은 막지 않는다. 운영 배포 전에 채운다.
QUOTE_SUPPLIER_NAME=""
QUOTE_SUPPLIER_REG_NO=""
QUOTE_SUPPLIER_CEO=""
QUOTE_SUPPLIER_ADDRESS=""
QUOTE_SUPPLIER_CONTACT=""

# 입금 계좌 (ADR-0019). 세 개가 모두 있어야 표기된다. 하나라도 비면 계좌 영역이 안 보인다.
# 만료·취소된 견적에는 표기하지 않는다. 값을 고치면 서버를 다시 띄워야 반영된다.
QUOTE_SUPPLIER_BANK_NAME=""
QUOTE_SUPPLIER_ACCOUNT_HOLDER=""
QUOTE_SUPPLIER_ACCOUNT_NO=""
